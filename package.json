{
  "name": "gogreen-mvp",
  "version": "2.0.0",
  "description": "Design your GitHub contribution graph, preview it in the terminal, then build it. Zero dependencies.",
  "type": "module",
  "main": "./src/cli.js",
  "bin": {
    "gg": "./bin/gg.js"
  },
  "exports": {
    ".": "./src/cli.js",
    "./planner": "./src/planner.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/gg.js",
    "preview": "node bin/gg.js",
    "lint": "node scripts/check-chars.mjs",
    "test": "node --test && node scripts/check-chars.mjs",
    "verify": "node --test && node scripts/check-chars.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "git",
    "github",
    "github-profile",
    "contribution-graph",
    "contribution-calendar",
    "contributions",
    "heatmap",
    "developer-tools",
    "cli",
    "nodejs",
    "zero-dependencies",
    "productivity",
    "portfolio",
    "personal-branding",
    "visualisation",
    "backdated-commits"
  ],
  "author": "Nihal Mishra",
  "license": "MIT"
}
