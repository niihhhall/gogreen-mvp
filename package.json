{
  "name": "gogreen-mvp",
  "version": "2.0.0",
  "description": "Design your GitHub contribution graph in the terminal. Preview the exact calendar, then build it with empty, backdated git commits. Seeded, safe by default, zero dependencies.",
  "homepage": "https://github.com/niihhhall/gogreen-mvp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niihhhall/gogreen-mvp.git"
  },
  "bugs": {
    "url": "https://github.com/niihhhall/gogreen-mvp/issues"
  },
  "type": "module",
  "main": "./src/cli.js",
  "bin": {
    "gg": "./bin/gg.js"
  },
  "exports": {
    ".": "./src/cli.js",
    "./planner": "./src/planner.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/gg.js",
    "preview": "node bin/gg.js",
    "lint": "node scripts/check-chars.mjs",
    "test": "node --test && node scripts/check-chars.mjs",
    "verify": "node --test && node scripts/check-chars.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "git",
    "github",
    "github-profile",
    "contribution-graph",
    "contribution-calendar",
    "contributions",
    "github-contributions",
    "heatmap",
    "developer-tools",
    "cli",
    "terminal",
    "nodejs",
    "javascript",
    "zero-dependencies",
    "git-commits",
    "commit-history",
    "productivity",
    "portfolio",
    "personal-branding",
    "visualization",
    "backdated-commits"
  ],
  "author": "Nihal Mishra",
  "license": "MIT"
}
